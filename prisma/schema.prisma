generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity (Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Null for users who only ever signed in with an OAuth provider.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  business Business?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Commercial resources. Everything below hangs off Business.
// ---------------------------------------------------------------------------

model Business {
  id         String  @id @default(cuid())
  userId     String  @unique
  name       String
  email      String?
  phone      String?
  website    String?
  logoUrl    String?
  taxId      String?
  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String?

  defaultCurrency  String   @default("USD")
  defaultLanguage  String   @default("en")
  defaultTaxRate   Decimal? @db.Decimal(5, 2)
  paymentTermsDays Int      @default(14)
  timezone         String   @default("UTC")

  invoicePrefix      String @default("INV-")
  invoiceNextNumber  Int    @default(1)
  estimatePrefix     String @default("EST-")
  estimateNextNumber Int    @default(1)

  // Printed on every document: bank details, IBAN, payment links.
  paymentInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients  Client[]
  products Product[]
  invoices Invoice[]
}

model Client {
  id         String  @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  company    String?
  taxId      String?
  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String?
  currency   String?
  notes      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft delete: invoices keep referencing clients that were removed from the list.
  deletedAt DateTime?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([businessId, name])
  @@index([businessId, email])
}

model Product {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  unit            String?
  unitPrice       Decimal  @db.Decimal(12, 2)
  currency        String?
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  taxExempt       Boolean  @default(false)
  taxExemptReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@index([businessId, name])
}

// ---------------------------------------------------------------------------
// Invoicing
// ---------------------------------------------------------------------------

/// Persisted lifecycle. OVERDUE is derived when reading (a past due date with a balance), never stored.
enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum DocumentTemplate {
  MODERN
  CLASSIC
  MINIMAL
  PROFESSIONAL
  BOLD
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  PAYPAL
  OTHER
}

enum InvoiceEventType {
  CREATED
  UPDATED
  SENT
  VIEWED
  PAYMENT_ADDED
  PAYMENT_REMOVED
  CANCELLED
  LINK_REVOKED
  DUPLICATED
}

model Invoice {
  id         String        @id @default(cuid())
  businessId String
  clientId   String?
  /// Position in the business's continuous sequence; `number` is its formatted label.
  sequence   Int
  number     String
  status     InvoiceStatus @default(DRAFT)
  issueDate  DateTime      @db.Date
  dueDate    DateTime      @db.Date
  currency   String

  // Calculated on the server and persisted, so history never changes.
  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  tax        Decimal @default(0) @db.Decimal(12, 2)
  total      Decimal @default(0) @db.Decimal(12, 2)
  amountPaid Decimal @default(0) @db.Decimal(12, 2)
  amountDue  Decimal @default(0) @db.Decimal(12, 2)

  notes    String?
  terms    String?
  template DocumentTemplate @default(MODERN)
  color    String           @default("#1e40af")

  publicToken String?   @unique
  sentAt      DateTime?
  viewedAt    DateTime?
  cancelledAt DateTime?

  /// Business and client as they were when the invoice was sent. Drafts render live data.
  issuerSnapshot Json?
  billToSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client   Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]
  events   InvoiceEvent[]

  @@unique([businessId, sequence])
  @@index([businessId, status])
  @@index([businessId, dueDate])
  @@index([clientId])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  productId String?
  position  Int

  description     String
  quantity        Decimal       @default(1) @db.Decimal(12, 3)
  /// Null while a draft line has no price yet; sending requires one.
  unitPrice       Decimal?      @db.Decimal(12, 2)
  discountType    DiscountType?
  discountValue   Decimal?      @db.Decimal(12, 2)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  taxExempt       Boolean       @default(false)
  taxExemptReason String?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId, position])
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  amount         Decimal       @db.Decimal(12, 2)
  currency       String
  paymentDate    DateTime      @db.Date
  method         PaymentMethod
  reference      String?
  notes          String?
  /// Optional client-supplied key so retries don't record the same payment twice.
  idempotencyKey String?
  createdAt      DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, idempotencyKey])
  @@index([invoiceId])
}

model InvoiceEvent {
  id        String           @id @default(cuid())
  invoiceId String
  type      InvoiceEventType
  metadata  Json?
  createdAt DateTime         @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
}
