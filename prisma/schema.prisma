generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity (Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Null for users who only ever signed in with an OAuth provider.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  business Business?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Commercial resources. Everything below hangs off Business.
// ---------------------------------------------------------------------------

model Business {
  id         String  @id @default(cuid())
  userId     String  @unique
  name       String
  email      String?
  phone      String?
  website    String?
  logoUrl    String?
  taxId      String?
  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String?

  defaultCurrency  String   @default("USD")
  defaultLanguage  String   @default("en")
  defaultTaxRate   Decimal? @db.Decimal(5, 2)
  paymentTermsDays Int      @default(14)
  timezone         String   @default("UTC")

  invoicePrefix      String @default("INV-")
  invoiceNextNumber  Int    @default(1)
  estimatePrefix     String @default("EST-")
  estimateNextNumber Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients  Client[]
  products Product[]
}

model Client {
  id         String  @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  company    String?
  taxId      String?
  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String?
  currency   String?
  notes      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft delete: invoices keep referencing clients that were removed from the list.
  deletedAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, name])
  @@index([businessId, email])
}

model Product {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  unit            String?
  unitPrice       Decimal  @db.Decimal(12, 2)
  currency        String?
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  taxExempt       Boolean  @default(false)
  taxExemptReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, name])
}
