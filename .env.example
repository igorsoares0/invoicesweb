# Local Postgres from docker-compose (port 5434). In production point this at Neon.
DATABASE_URL="postgresql://invoices:invoices@localhost:5434/invoices_dev"
# Used by integration and E2E tests. Never point this at a database you care about: tests wipe it.
DATABASE_URL_TEST="postgresql://invoices:invoices@localhost:5434/invoices_test"

# Generate with: npx auth secret  (or: openssl rand -base64 33)
AUTH_SECRET=""
# Public base URL. Leave unset locally (the request host is used); set it in production.
# AUTH_URL="https://app.example.com"

# Optional. Google sign-in is disabled when these are empty.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional. Sending by email is disabled when this is empty.
# The default sender below is Resend's sandbox: it only delivers to your own Resend account
# address. Verify a domain and set EMAIL_FROM to send to clients.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
# Set to "capture" to record emails instead of sending them. The test runners set it themselves.
# EMAIL_TRANSPORT="capture"
